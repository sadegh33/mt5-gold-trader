# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PUBLIC_URL=https://your-server.example.com   # برای EA یا webhook (در صورت استفاده از ngrok/servicename)

# Symbol & strategy
SYMBOL=Gold
TIMEFRAME=1h
RISK_PERCENT=1.0

# Strategy params
EMA_SHORT=20
EMA_LONG=50
RSI_PERIOD=14
ATR_PERIOD=14
MAX_TRADES_PER_DAY=3

# Data source mode: "public" یا "mt5" (mt5 یعنی EA تواضع قیمت/تریدها به سرور فوروارد می‌کند)
DATA_MODE=public
